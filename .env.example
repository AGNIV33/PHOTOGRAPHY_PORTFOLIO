# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Supabase → Project Settings → API (or "API Keys")
NEXT_PUBLIC_SUPABASE_URL=
# "Publishable key" (older projects call it "anon public")
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "Secret key" (older projects call it "service_role"). Keep private.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary → Dashboard (Programmable Media) → Product environment credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# The two admin emails are fixed in src/config/admins.ts.
