# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Supabase → Project Settings → API (or "API Keys")
NEXT_PUBLIC_SUPABASE_URL=
# "Publishable key" (older projects call it "anon public")
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "Secret key" (older projects call it "service_role"). Keep private.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary → Dashboard (Programmable Media) → Product environment credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# The two admin emails are fixed in src/config/admins.ts.

# EmailJS (contact form) -> https://dashboard.emailjs.com
# Email Services -> the Service ID, Email Templates -> the Template ID, Account -> the Public Key.
# The email address that receives the messages is set in the EmailJS template, not here.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=


# Optional: photo categories by AI (Street, Nature, Landscape...). Black & white / colour is
# measured without AI. Use ONE of these; the NVIDIA one has a free tier (build.nvidia.com).
NVIDIA_API_KEY=
# NVIDIA_VISION_MODEL=meta/llama-3.2-90b-vision-instruct
ANTHROPIC_API_KEY=
